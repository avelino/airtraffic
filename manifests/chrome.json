{
  "manifest_version": 3,
  "name": "Air Traffic",
  "version": "2.0.0",
  "description": "Routes tabs into Chrome tab groups automatically, based on URL rules you define.",
  "author": "Thiago Avelino <avelinorun@gmail.com>",
  "homepage_url": "https://github.com/avelino/airtraffic",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabGroups",
    "tabs",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Air Traffic",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "115"
}
